#!/bin/bash
# Usage: hub start   (start the 4-app GTM workflow + gateway)
#        hub stop    (stop all)
#        hub status  (show what's running)

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

stop_all() {
  echo "Stopping GTM First Touch..."
  pkill -f "scripts/gateway.py serve" 2>/dev/null
  pkill -f "discovery.py serve" 2>/dev/null
  pkill -f "outbound_email.py serve" 2>/dev/null
  pkill -f "enrichment.py serve" 2>/dev/null
  pkill -f "icp_scorer.py serve" 2>/dev/null
  echo "Done."
}

start_all() {
  stop_all 2>/dev/null

  echo "Starting GTM First Touch..."
  python3 apps/discovery/discovery.py serve --port 3005 --prefix /discovery &
  python3 apps/outbound-email/outbound_email.py serve --port 3008 --prefix /outbound-email &
  python3 apps/enrichment/enrichment.py serve --port 3011 --prefix /enrichment &
  python3 apps/icp-scorer/icp_scorer.py serve --port 3012 --prefix /icp-scorer &
  sleep 1
  python3 scripts/gateway.py serve --port 8000 &

  echo ""
  echo "GTM First Touch running at http://localhost:8000"
  echo "Run './hub stop' to shut down."
  echo ""
  wait
}

show_status() {
  echo "App status:"
  for pattern in "scripts/gateway.py" "discovery.py" "outbound_email.py" "enrichment.py" "icp_scorer.py"; do
    name="${pattern##*/}"
    name="${name%.py}"
    if pgrep -f "${pattern} serve" >/dev/null 2>&1; then
      echo "  $name: running"
    else
      echo "  $name: stopped"
    fi
  done
}

case "$1" in
  start)  start_all ;;
  stop)   stop_all ;;
  status) show_status ;;
  *)
    echo "Usage: hub {start|stop|status}"
    exit 1
    ;;
esac
